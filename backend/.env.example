APP_NAME=D2A Health API
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://d2a:d2a@localhost:5432/d2a_health
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TIMEOUT_SECONDS=8
DEMO_LOGIN_EMAIL=demo@d2a.health
DEMO_LOGIN_PASSWORD=demo-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-email-app-password
SMTP_FROM_EMAIL=your-email@example.com
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_PROVIDER=brevo
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=your-verified-brevo-sender@example.com
EMAIL_FROM_NAME=D2A Health
EMAIL_LOGO_URL=https://your-vercel-domain.vercel.app/favicon.svg
EMAIL_TIMEOUT_SECONDS=10
